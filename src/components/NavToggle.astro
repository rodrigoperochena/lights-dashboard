---
<button
  class="navigation-toggle"
  type="button"
  aria-expanded="false"
  data-navigation-toggle
>
  <span class="navigation-toggle-text">menu</span>
  <span class="navigation-toggle-icon" aria-hidden="true"></span>
</button>

<style lang="scss">
  @use "@ulubit/foundations/breakpoints" as *;

  .navigation-toggle {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    
    border: none;
    padding: 0;
    background-color: transparent;
  }

  .navigation-toggle-text {
    font-size: var(--step-1);
    line-height: 0;
    transition: var(--transition-duration-fast);
  }

  .navigation-toggle-icon {
    display: block;
    width: var(--step-1);
    height: var(--step-0);
    position: relative;

    &::before,
    &::after {
      content: "";
      width: 100%;
      height: 1px;
      position: absolute;
      right: 0;
      background-color: currentColor;
      transition: var(--transition-duration-fast);
    }

    &::before {
      top: calc(100%/4 - 1px);
      width: calc(100%/1.5);
    }

    &::after {
      bottom: calc(100%/4 - 1px);
    }
  }

  .navigation-toggle[aria-expanded="true"] {
    .navigation-toggle-icon {
      &::before {
        top: 50%;
        width: 100%;
        transform: rotate(-45deg);
      }

      &::after {
        top: 50%;
        transform: rotate(45deg);
      }
    }
  }
</style>