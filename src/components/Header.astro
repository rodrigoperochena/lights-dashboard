---
import { getLights } from "@/data/lights";
import AreaPowerControls from "./AreaPowerControls.astro";
import SceneControls from "./SceneControls.astro"
import SiteBrand from "./SiteBrand.astro"

const lights = await getLights()
---
<header class="site-header" data-site-header>
  <div class="container">
    <SiteBrand />
    <AreaPowerControls lights={lights} />
  </div>
</header>

<style lang="scss">
  @use "@ulubit/foundations/breakpoints" as *;

  header {
    position: fixed;
    top: 0;
    height: var(--header-height);
    width: 100%;
    z-index: 2;
    transition: var(--transition-duration);

    display: grid;
    align-content: center;
    background-color: var(--color-bg);
  }

  .container {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2xs);
    height: 100%;
    width: 100%;
    max-width: 100%;
    position: relative;
    padding-inline: var(--space-xs);

    @include at(xl) {
      padding-inline: var(--space-l);
    }
  }
</style>