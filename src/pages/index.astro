---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { siteConfig } from "@/site.config";
import LightCard from "@/components/LightCard.astro";
import { getLights, selectLightsForArea } from "@/data/lights";
import BedroomIcon from "@/assets/svg/bedroom.svg"
import BathroomIcon from "@/assets/svg/bath.svg"
import AreaPowerControls from "@/components/AreaPowerControls.astro";


const lights = await getLights()
const bedroomLights = lights.filter((light) => light.room === "bedroom")
const deskLights = selectLightsForArea(lights, "bedroom", "desk")
const wardrobeLights = bedroomLights.filter((room) => room.area === "wardrobe")
const bathroomLights = lights.filter((light) => light.room === "bathroom")

const title = siteConfig.title
const description = siteConfig.description
const bodyClass = "page-home"
---
<BaseLayout {title} {description} {bodyClass}>
  <main id="main-content">

    <div class="lights">
      <div class="container">
        <AreaPowerControls lights={lights} />

        <section class:list={["lights-section", "lights-section-room"]}>
          <h2 class="heading"><BedroomIcon />Bedroom</h2>
          
          <div class="lights-section-container">
            <section class:list={["lights-section", "lights-section-area"]}>
              <header class="lights-section-header">
                <h3 class="heading">Desk lights</h3>
                <AreaPowerControls lights={deskLights} />
              </header>

              <div class="cards">
                {deskLights.map((light) => (
                  <LightCard {light} />
                ))}
              </div>
            </section>

            <section class:list={["lights-section", "lights-section-area"]}>
              <header class="lights-section-header">
                <h3 class="heading">Wardrobe lights</h3>
                <AreaPowerControls lights={wardrobeLights} />
              </header>

              <div class="cards">
                {wardrobeLights.map((light) => (
                  <LightCard {light} />
                ))}
              </div>
            </section>
          </div>

        </section>

        <section class:list={["lights-section", "lights-section-room"]}>
          <div class="lights-section-header">
            <h2 class="heading"><BathroomIcon />Bathroom</h2>
            <AreaPowerControls lights={bathroomLights} />
          </div>

          <div class="cards">
            {bathroomLights.map((light) => (
              <LightCard {light} />
            ))}
          </div>
        </section>

      </div>

    </div>
  </main>
</BaseLayout>

<style lang="scss">
  @use "@ulubit/foundations/breakpoints" as *;

  .lights {
    display: grid;
    align-items: center;
    padding-top: var(--space-m);

    .container {
      width: 100%;
    }
  }

  .lights-section-room {
    margin-bottom: var(--space-xl);
  }

  .lights-section-header {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
  }

  h2 {
    font-size: var(--step-2);
    svg {
      vertical-align: middle;
      margin-right: var(--space-2xs);
    }
  }

  .lights-section-container {
    display: grid;
    gap: var(--space-m);
    margin-top: var(--space-xs);
  }

  .cards {
    display: grid;
    gap: var(--space-s);
    margin-top: var(--space-xs);

    @include at(md) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    @include at(xl) {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    @include at(3xl) {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>