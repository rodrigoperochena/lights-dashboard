---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { siteConfig } from "@/site.config";
import { ButtonLink } from "@ulubit/ui";
import GithubIcon from "@/assets/github.svg"
import LightCard from "@/components/LightCard.astro";
import { getLightsForCard } from "@/data/lights";
import BedroomIcon from "@/assets/svg/bedroom.svg"
import BathroomIcon from "@/assets/svg/bath.svg"
import KitchenIcon from "@/assets/svg/fridge.svg"


const lights = await getLightsForCard()
const bedroomLights = lights.filter((light) => light.room === "bedroom")
const deskLights = bedroomLights.filter((room) => room.area === "desk")
const deskLightsSorted = deskLights.toSorted((a, b) => a.order - b.order)
const wardrobeLights = bedroomLights.filter((room) => room.area === "wardrobe")
const bathroomLights = lights.filter((light) => light.room === "bathroom")

const title = siteConfig.title
const description = siteConfig.description
const bodyClass = "page-home"
---
<BaseLayout {title} {description} {bodyClass}>
  <main id="main-content">

    <section class="lights">
      <div class="container">

        <div class="lights-room">
          <h2 class="heading"><BedroomIcon />Bedroom</h2>
          
          <div class="lights-room-container">
            <div class="lights-area">
              <h3 class="heading">Desk lights</h3>
              <div class="cards">
                {deskLightsSorted.map((light) => (
                  <LightCard {light} />
                ))}
              </div>
            </div>
            <div class="lights-area">
              <h3 class="heading">Wardrobe lights</h3>
              <div class="cards">
                {wardrobeLights.map((light) => (
                  <LightCard {light} />
                ))}
              </div>
            </div>
          </div>

        </div>

        <div class="lights-room">
          <h2 class="heading"><BathroomIcon />Bathroom</h2>
          <div class="cards">
            {bathroomLights.map((light) => (
              <LightCard {light} />
            ))}
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style lang="scss">
  @use "@ulubit/foundations/breakpoints" as *;

  .lights {
    display: grid;
    align-items: center;
    padding-top: var(--space-m);

    @media (height <= 42rem) {
      height: 100%;
    }

    @media (42rem <= height) {
      height: 100%;
    }

    .container {
      width: 100%;
    }
  }

  .lights-room {
    margin-bottom: var(--space-xl);
  }

  h2 {
    text-align: center;

    svg {
      vertical-align: middle;
      margin-right: var(--space-2xs);
    }
  }

  .lights-room-container {
    display: grid;
    gap: var(--space-m);
    margin-top: var(--space-xs);
  }

  .cards {
    display: grid;
    gap: var(--space-s);
    margin-top: var(--space-2xs);

    @include at(md) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    @include at(xl) {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    @include at(3xl) {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>